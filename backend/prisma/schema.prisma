generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Branch {
  id           String         @id @default(cuid())
  code         String         @unique
  name         String
  city         String
  address      String?
  phone        String?
  active       Boolean        @default(true)
  users        UserBranch[]
  doctors      Doctor[]
  appointments Appointment[]
  invoices     Invoice[]
  stocks       Stock[]
  cases        ClinicalCase[]
  userLimit    Int            @default(20)
  createdAt    DateTime       @default(now())
}

model User {
  id           String       @id @default(cuid())
  email        String       @unique
  name         String
  passwordHash String
  role         String
  active       Boolean      @default(true)
  branches     UserBranch[]
  createdAt    DateTime     @default(now())
}

model UserBranch {
  userId   String
  branchId String
  user     User   @relation(fields: [userId], references: [id])
  branch   Branch @relation(fields: [branchId], references: [id])

  @@id([userId, branchId])
}

model Owner {
  id           String        @id @default(cuid())
  name         String
  phone        String
  email        String?
  pets         Pet[]
  appointments Appointment[]
  createdAt    DateTime      @default(now())
}

model Pet {
  id           String         @id @default(cuid())
  petCode      String         @unique
  name         String
  species      String
  breed        String?
  birthDate    DateTime?
  ownerId      String
  owner        Owner          @relation(fields: [ownerId], references: [id])
  appointments Appointment[]
  cases        ClinicalCase[]
}

model Doctor {
  id           String        @id @default(cuid())
  name         String
  specialty    String
  branchId     String
  branch       Branch        @relation(fields: [branchId], references: [id])
  active       Boolean       @default(true)
  appointments Appointment[]
}

model Service {
  id     String  @id @default(cuid())
  name   String
  price  Decimal @db.Decimal(12, 2)
  active Boolean @default(true)
}

model Appointment {
  id        String   @id @default(cuid())
  branchId  String
  branch    Branch   @relation(fields: [branchId], references: [id])
  doctorId  String
  doctor    Doctor   @relation(fields: [doctorId], references: [id])
  ownerId   String
  owner     Owner    @relation(fields: [ownerId], references: [id])
  petId     String
  pet       Pet      @relation(fields: [petId], references: [id])
  startAt   DateTime
  status    String   @default("BOOKED")
  notes     String?
  createdAt DateTime @default(now())

  @@unique([doctorId, startAt])
}

model Product {
  id          String      @id @default(cuid())
  name        String
  category    String
  description String?
  price       Decimal     @db.Decimal(12, 2)
  imageUrl    String?
  active      Boolean     @default(true)
  stocks      Stock[]
  orderItems  OrderItem[]
}

model Stock {
  id        String    @id @default(cuid())
  branchId  String
  branch    Branch    @relation(fields: [branchId], references: [id])
  productId String
  product   Product   @relation(fields: [productId], references: [id])
  quantity  Int       @default(0)
  batch     String?
  expiry    DateTime?

  @@unique([branchId, productId])
}

model ShopOrder {
  id           String      @id @default(cuid())
  customerName String
  phone        String
  address      String
  status       String      @default("UNPAID")
  amount       Decimal     @db.Decimal(12, 2)
  items        OrderItem[]
  createdAt    DateTime    @default(now())
}

model OrderItem {
  id        String    @id @default(cuid())
  orderId   String
  order     ShopOrder @relation(fields: [orderId], references: [id])
  productId String
  product   Product   @relation(fields: [productId], references: [id])
  quantity  Int
  price     Decimal   @db.Decimal(12, 2)
}

model Invoice {
  id          String    @id @default(cuid())
  number      String    @unique
  branchId    String
  branch      Branch    @relation(fields: [branchId], references: [id])
  ownerName   String
  description String
  amount      Decimal   @db.Decimal(12, 2)
  paid        Decimal   @default(0) @db.Decimal(12, 2)
  status      String    @default("DUE")
  payments    Payment[]
  createdAt   DateTime  @default(now())
}

model Payment {
  id         String   @id @default(cuid())
  invoiceId  String
  invoice    Invoice  @relation(fields: [invoiceId], references: [id])
  amount     Decimal  @db.Decimal(12, 2)
  method     String
  reference  String?
  receivedBy String?
  createdAt  DateTime @default(now())
}

model ClinicalCase {
  id        String   @id @default(cuid())
  type      String
  branchId  String
  branch    Branch   @relation(fields: [branchId], references: [id])
  petId     String
  pet       Pet      @relation(fields: [petId], references: [id])
  status    String   @default("OPEN")
  title     String
  notes     String?
  data      Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Audit {
  id       String   @id @default(cuid())
  actorId  String?
  action   String
  entity   String
  entityId String?
  details  Json?
  at       DateTime @default(now())
}

// Branch-aware kennel reservations and itemized boarding care, with auditable checkout.
model Kennel {
  id           String         @id @default(cuid())
  branchId     String
  code         String
  name         String
  active       Boolean        @default(true)
  ratePerNight Decimal        @db.Decimal(12, 2)
  stays        BoardingStay[]

  @@unique([branchId, code])
}

model BoardingStay {
  id               String        @id @default(cuid())
  branchId         String
  petId            String
  kennelId         String
  kennel           Kennel        @relation(fields: [kennelId], references: [id])
  checkIn          DateTime
  checkOutExpected DateTime
  checkOutActual   DateTime?
  status           String        @default("RESERVED")
  feedingNotes     String?
  medicationNotes  String?
  nightlyRate      Decimal       @db.Decimal(12, 2)
  logs             BoardingLog[]
  invoiceId        String?
  createdAt        DateTime      @default(now())
}

model BoardingLog {
  id        String       @id @default(cuid())
  stayId    String
  stay      BoardingStay @relation(fields: [stayId], references: [id])
  type      String
  notes     String
  staffId   String
  createdAt DateTime     @default(now())
}

// Web-stage clinical records. Finalised documents remain immutable; corrections require amendments.
model Consultation {
  id            String         @id @default(cuid())
  branchId      String
  petId         String
  doctorUserId  String?
  appointmentId String?
  symptoms      String
  vitals        Json?
  diagnosis     String?
  treatment     String?
  followUpAt    DateTime?
  status        String         @default("DRAFT")
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  prescriptions Prescription[]
  labOrders     LabOrder[]
}

model Prescription {
  id             String       @id @default(cuid())
  consultationId String
  consultation   Consultation @relation(fields: [consultationId], references: [id])
  items          Json
  issuedAt       DateTime?
  status         String       @default("DRAFT")
  createdAt      DateTime     @default(now())
}

model LabOrder {
  id                 String       @id @default(cuid())
  consultationId     String
  consultation       Consultation @relation(fields: [consultationId], references: [id])
  testName           String
  findings           Json?
  status             String       @default("ORDERED")
  arrivedAt          DateTime?
  acceptedById       String?
  invoiceId          String?
  clinicalReason     String?
  urgency            String       @default("ROUTINE")
  reportReviewedAt   DateTime?
  reportReviewedById String?
  reviewNotes        String?
  reportedAt         DateTime?
  releasedAt         DateTime?
  approvedById       String?
  createdAt          DateTime     @default(now())
}

model Admission {
  id             String    @id @default(cuid())
  petId          String
  branchId       String
  bedCode        String
  admittedAt     DateTime  @default(now())
  dischargedAt   DateTime?
  diagnosis      String?
  treatmentNotes String?
  status         String    @default("ADMITTED")
  dailyRate      Decimal   @db.Decimal(12, 2)
  createdAt      DateTime  @default(now())
}

model Surgery {
  id               String   @id @default(cuid())
  branchId         String
  petId            String
  surgeonId        String?
  procedureName    String
  scheduledAt      DateTime
  status           String   @default("SCHEDULED")
  preOpNotes       String?
  anaesthesiaNotes String?
  operativeNotes   String?
  postOpNotes      String?
  fee              Decimal  @db.Decimal(12, 2)
  createdAt        DateTime @default(now())
}

model ClinicalDocument {
  id            String   @id @default(cuid())
  branchId      String
  petId         String
  type          String
  referenceId   String?
  title         String
  contents      Json
  generatedById String
  createdAt     DateTime @default(now())
}

model InvoiceItem {
  id          String  @id @default(cuid())
  invoiceId   String
  description String
  quantity    Int     @default(1)
  unitPrice   Decimal @db.Decimal(12, 2)
  taxRate     Decimal @default(0) @db.Decimal(5, 2)
}

// New department inventory and vaccinations; retain historical batches and movements.
model InventoryItem {
  id         String           @id @default(cuid())
  sku        String           @unique
  name       String
  department String
  unit       String           @default("UNIT")
  hsnSac     String?
  gstRate    Decimal          @default(0) @db.Decimal(5, 2)
  active     Boolean          @default(true)
  batches    InventoryBatch[]
  createdAt  DateTime         @default(now())
}

model InventoryBatch {
  id          String              @id @default(cuid())
  itemId      String
  item        InventoryItem       @relation(fields: [itemId], references: [id])
  branchId    String
  batchNumber String
  expiry      DateTime?
  quantity    Int                 @default(0)
  unitCost    Decimal             @default(0) @db.Decimal(12, 2)
  movements   InventoryMovement[]
  createdAt   DateTime            @default(now())

  @@unique([branchId, itemId, batchNumber])
  @@index([branchId, itemId, expiry])
}

model InventoryMovement {
  id        String         @id @default(cuid())
  batchId   String
  batch     InventoryBatch @relation(fields: [batchId], references: [id])
  kind      String
  quantity  Int
  reference String?
  userId    String
  createdAt DateTime       @default(now())
}

model PetVaccination {
  id             String    @id @default(cuid())
  petId          String
  vaccine        String
  administeredAt DateTime?
  validUntil     DateTime?
  verifiedById   String?
  notes          String?
  createdAt      DateTime  @default(now())

  @@index([petId, validUntil])
}

model InvoiceTaxLine {
  id          String   @id @default(cuid())
  invoiceId   String
  description String
  hsnSac      String?
  quantity    Int
  unitPrice   Decimal  @db.Decimal(12, 2)
  discount    Decimal  @default(0) @db.Decimal(12, 2)
  gstRate     Decimal  @db.Decimal(5, 2)
  cgst        Decimal  @db.Decimal(12, 2)
  sgst        Decimal  @db.Decimal(12, 2)
  igst        Decimal  @db.Decimal(12, 2)
  total       Decimal  @db.Decimal(12, 2)
  createdAt   DateTime @default(now())

  @@index([invoiceId])
}

// Reception visit and daily branch token; unique per branch/day/number.
model Visit {
  id             String    @id @default(cuid())
  branchId       String
  petId          String
  receptionistId String?
  doctorId       String?
  visitDate      String
  tokenNumber    Int
  status         String    @default("WAITING")
  reason         String?
  checkedInAt    DateTime  @default(now())
  checkedOutAt   DateTime?
  createdAt      DateTime  @default(now())

  @@unique([branchId, visitDate, tokenNumber])
  @@index([petId, createdAt])
}
